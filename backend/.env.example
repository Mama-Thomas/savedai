DATABASE_URL=postgresql://postgres:password@localhost:5432/savedai
OPENAI_API_KEY=sk-...your-openai-api-key-here...
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
# Session lifetime (minutes). 60 = 1 hour idle sign-out on the client.
JWT_EXPIRE_MINUTES=60
# Password reset link lifetime (minutes).
PASSWORD_RESET_EXPIRE_MINUTES=30
APP_ENV=development
# Public base URL the frontend is served from. Used for password-reset links.
APP_BASE_URL=http://localhost:3000
# Comma-separated list of allowed origins for CORS. Use your prod domain in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Resend email (https://resend.com). Leave blank in dev to log reset links to stdout instead.
RESEND_API_KEY=
RESEND_FROM_EMAIL=SavedAI <noreply@yourdomain.com>
